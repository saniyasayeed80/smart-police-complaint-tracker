# Safe defaults: demo fast-forward is on and all SMS is simulated.
DEMO_MODE=true
SMS_MODE=simulated
SMS_APPROVED=false

# Optional Twilio live testing; requires explicit consent and destination approval.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_APPROVED_NUMBERS=

# Optional Supabase Auth only; complaint store remains local PGlite.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Replace with long random secrets before any non-local deployment.
SESSION_SECRET=
CRON_SECRET=

# Optional local database directory.
# COMPLAINT_DB_DIR=.data/complaints
